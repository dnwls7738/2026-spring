<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.ac.kopo.mapper.BoardMapper">

  <!--
  	BoardMapper.java Mapper 인터페이스를 활용한 xmlMapper파일(BoardDAOImpl02.java)
  -->

	<!-- <select id="selectAll"  resultType="kr.ac.kopo.board.vo.BoardVO">
		select no, title, writer, to_char(reg_date, 'yyyy-mm-dd') as regDate from tbl_board order by no desc
	</select> -->
	
	<insert id="insert" parameterType="boardVO">
		insert into tbl_board(no, title, writer, content) values(seq_tbl_board_no.nextval, #{title}, #{writer}, #{content})
	</insert>
	
	<update id="viewCount" parameterType="int">
		update tbl_board set view_cnt = view_cnt + 1 where no = #{no}
	</update>
	
</mapper>